# A clean 975-byte urlencoded form POST.
rules crs

request pass POST /contact HTTP/1.1
header Host: shop.example
header User-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 14_5) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Safari/605.1.15
header Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
header Accept-Language: en-US,en;q=0.9
header Accept-Encoding: gzip, deflate, br
header Cookie: session=7f3c9a1e2b4d6f80; theme=dark
header Connection: keep-alive
header Content-Type: application/x-www-form-urlencoded
header Content-Length: 973
body name=Ada+Lovelace&email=ada%2540example.com&subject=Order+question&message=Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order+Hello+there,+I+have+a+question+about+my+recent+order
end
